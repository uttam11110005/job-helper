# ── AI provider ──────────────────────────────────────────────────────────────
# Recommended (FREE, no credit card): Google Gemini.
#   1. Go to https://aistudio.google.com/apikey and sign in with a Google account
#   2. "Create API key" → paste it below → restart `npm run dev`
GEMINI_API_KEY=

# Alternative free option: Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Paid option: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Optional overrides
# AI_PROVIDER=gemini        # gemini | groq | openai (default: first one with a key)
# AI_MODEL=gemini-flash-latest
# AI_VISION_MODEL=gemini-flash-latest

# With no key at all the app runs in offline Demo mode (keyword-based, much weaker).
